#!/usr/bin/env bash
set -u
cd "$(dirname "$0")" || exit 1
failures=0
if [ "${PERFORMANCE_MODULE_CONTRACT:-}" = passed ]; then
	printf 'PASS: Nix history module evaluation contract\n'
else
	printf 'FAIL: required module checks unavailable; run nix develop -c ./test\n' >&2
	failures=$((failures+1))
fi
for suite in tests/unit/core.lua tests/unit/config.lua tests/unit/runner.lua tests/unit/encoding.lua tests/integration/storage.lua tests/integration/process.lua tests/integration/provenance.lua tests/integration/concurrent.lua tests/integration/pilot.lua; do
	if luajit "$suite"; then :; else failures=$((failures+1)); fi
done
if ./tests/cli/test_cli; then :; else failures=$((failures+1)); fi
exit "$failures"
